<?xml version="1.0" encoding="UTF-8"?>
<!-- Sales by period. All values arrive formatted (see SalesReportPdf); this file is layout only. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sales" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40"
              whenNoDataType="AllSectionsNoDetail" language="java">
    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9" forecolor="#0F172A"/>
    <style name="Muted" style="Base" forecolor="#64748B"/>
    <style name="Header" style="Base" fontSize="8" isBold="true" forecolor="#64748B" mode="Opaque" backcolor="#F8FAFC"/>

    <parameter name="PERIOD" class="java.lang.String"/>
    <parameter name="GENERATED_AT" class="java.lang.String"/>
    <parameter name="SALE_COUNT" class="java.lang.String"/>
    <parameter name="TOTAL_AMOUNT" class="java.lang.String"/>
    <parameter name="EMPTY" class="java.lang.Boolean"/>

    <field name="date" class="java.lang.String"/>
    <field name="sale" class="java.lang.String"/>
    <field name="customer" class="java.lang.String"/>
    <field name="units" class="java.lang.String"/>
    <field name="total" class="java.lang.String"/>

    <title>
        <band height="92">
            <rectangle radius="6">
                <reportElement x="0" y="0" width="22" height="22" backcolor="#4F46E5"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="0" width="22" height="22" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <text><![CDATA[M]]></text>
            </staticText>
            <staticText>
                <reportElement x="30" y="0" width="200" height="22"/>
                <textElement verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <text><![CDATA[Mini ERP]]></text>
            </staticText>
            <textField>
                <reportElement style="Muted" x="315" y="0" width="200" height="22"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["Gerado em " + $P{GENERATED_AT}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="38" width="515" height="26"/>
                <textElement><font size="18" isBold="true"/></textElement>
                <text><![CDATA[Relatório de vendas]]></text>
            </staticText>
            <textField>
                <reportElement style="Muted" x="0" y="64" width="515" height="16"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Período: " + $P{PERIOD} + " · somente vendas confirmadas"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <printWhenExpression><![CDATA[!$P{EMPTY}]]></printWhenExpression>
            <staticText><reportElement style="Header" x="0" y="0" width="110" height="24"/><box leftPadding="8"/><textElement verticalAlignment="Middle"/><text><![CDATA[DATA]]></text></staticText>
            <staticText><reportElement style="Header" x="110" y="0" width="60" height="24"/><textElement verticalAlignment="Middle"/><text><![CDATA[VENDA]]></text></staticText>
            <staticText><reportElement style="Header" x="170" y="0" width="215" height="24"/><textElement verticalAlignment="Middle"/><text><![CDATA[CLIENTE]]></text></staticText>
            <staticText><reportElement style="Header" x="385" y="0" width="50" height="24"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[ITENS]]></text></staticText>
            <staticText><reportElement style="Header" x="435" y="0" width="80" height="24"/><box rightPadding="8"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[TOTAL]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <line><reportElement x="0" y="21" width="515" height="1"/><graphicElement><pen lineWidth="0.75" lineColor="#E6E8EF"/></graphicElement></line>
            <textField><reportElement x="0" y="0" width="110" height="21"/><box leftPadding="8"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{date}]]></textFieldExpression></textField>
            <textField><reportElement style="Muted" x="110" y="0" width="60" height="21"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{sale}]]></textFieldExpression></textField>
            <textField textAdjust="ScaleFont"><reportElement x="170" y="0" width="210" height="21"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{customer}]]></textFieldExpression></textField>
            <textField><reportElement x="385" y="0" width="50" height="21"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{units}]]></textFieldExpression></textField>
            <textField><reportElement x="435" y="0" width="80" height="21"/><box rightPadding="8"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{total}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement style="Muted" x="315" y="4" width="200" height="16"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="70">
            <staticText>
                <reportElement style="Muted" x="0" y="14" width="515" height="20">
                    <printWhenExpression><![CDATA[$P{EMPTY}]]></printWhenExpression>
                </reportElement>
                <textElement><font size="10"/></textElement>
                <text><![CDATA[Nenhuma venda no período.]]></text>
            </staticText>
            <frame>
                <reportElement mode="Opaque" x="275" y="12" width="240" height="50" backcolor="#EEF2FF">
                    <printWhenExpression><![CDATA[!$P{EMPTY}]]></printWhenExpression>
                </reportElement>
                <textField>
                    <reportElement style="Muted" x="12" y="8" width="216" height="14"/>
                    <textFieldExpression><![CDATA["Quantidade de vendas: " + $P{SALE_COUNT}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="12" y="24" width="100" height="20"/>
                    <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                    <text><![CDATA[Total vendido]]></text>
                </staticText>
                <textField>
                    <reportElement x="100" y="24" width="128" height="20" forecolor="#4338CA"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="13" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$P{TOTAL_AMOUNT}]]></textFieldExpression>
                </textField>
            </frame>
        </band>
    </summary>
</jasperReport>
